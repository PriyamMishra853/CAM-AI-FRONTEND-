# ─────────────────────────────────────────────────────────────
# CAM AI frontend configuration
# Copy to .env.local and fill in once the backend is reachable.
# ─────────────────────────────────────────────────────────────

# Server 01 — main application / memory layer (Node.js API).
# Leave empty to run the site in DEMO mode (visualization data only).
VITE_SERVER01_API_URL=

# Optional: WebSocket endpoint on Server 01 for live status pushes.
VITE_SERVER01_WS_URL=

# Optional: browser-playable proxy of an RTSP feed (HLS/WebRTC/MP4).
# Browsers cannot play rtsp:// directly — Server 01 must restream it.
VITE_HERO_VIDEO_URL=

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=8000
